# Firebase web app config (from Firebase console → Project settings → Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Cloudflare tunnel token — `cloudflared tunnel token food-dev`
CLOUDFLARED_TUNNEL_TOKEN=

# Claude Code gateway for the dev container (Anthropic-compatible endpoint).
# ANTHROPIC_AUTH_TOKEN is a secret — keep it only in the gitignored .env.
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_MODEL=
ANTHROPIC_DEFAULT_OPUS_MODEL=
ANTHROPIC_DEFAULT_SONNET_MODEL=
ANTHROPIC_DEFAULT_HAIKU_MODEL=
CLAUDE_CODE_SUBAGENT_MODEL=
CLAUDE_CODE_EFFORT_LEVEL=
CLAUDE_CODE_AUTO_COMPACT_WINDOW=
