rules_version = '2';

// Family recipe app — Firestore security rules.
//
// Access is controlled by ONE doc the owner edits in the console:
//   settings/config -> { allowedEmails: ["owner@gmail.com", "mom@gmail.com", ...] }
//
// Reads (recipes + images) are PUBLIC so guests can browse without signing in.
// Only allowlisted emails may create/update recipes (and thus upload images).
// The allowlist doc (settings/config) is itself readable only by allowlisted
// users, so non-allowlisted accounts can't see who has access.
// Deletes require an admin role doc:
//   users/<uid> -> { role: "admin" }
//
// Bootstrap (via console, after signing in once):
//   1. settings/config = { allowedEmails: ["<owner@gmail.com>"] }
//   2. users/<owner-uid> = { role: "admin" }
// Add new family members by editing settings/config.allowedEmails only.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAllowedUser() {
      return isSignedIn()
        && request.auth.token.email in get(/databases/$(database)/documents/settings/config).data.allowedEmails;
    }

    function isAdmin() {
      return isAllowedUser()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /settings/config {
      // Only allowlisted users can read the list itself, so a non-allowlisted
      // signed-in user can't discover the family's email addresses.
      allow read: if isSignedIn()
        && request.auth.token.email in resource.data.allowedEmails;
      allow write: if isAdmin();
    }

    match /recipes/{recipeId} {
      allow read: if true;
      allow create: if isAllowedUser()
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAllowedUser();
      allow delete: if isAdmin();
    }

    match /recipeImages/{imageId} {
      allow read: if true;
      allow create, update, delete: if isAllowedUser();
    }

    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['displayName', 'role'])
        && request.resource.data.get('role', null) == null;
      allow update: if isAdmin()
        || (request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName']));
      allow delete: if isAdmin();
    }
  }
}
