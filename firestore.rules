rules_version = '2';

// Family recipe app — Firestore security rules.
//
// Access is controlled by ONE doc the owner edits in the console:
//   settings/config -> { allowedEmails: ["owner@gmail.com", "mom@gmail.com", ...] }
//
// Only allowlisted emails may create/update recipes (and thus upload images).
// Reads still work for any signed-in user. Deletes require an admin role doc:
//   users/<uid> -> { role: "admin" }
//
// Bootstrap (via console, after signing in once):
//   1. settings/config = { allowedEmails: ["<owner@gmail.com>"] }
//   2. users/<owner-uid> = { role: "admin" }
// Add new family members by editing settings/config.allowedEmails only.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAllowedUser() {
      if (!isSignedIn()) {
        return false;
      }
      let config = get(/databases/$(database)/documents/settings/config).data;
      return config != null
        && request.auth.token.email in config.allowedEmails;
    }

    function isAdmin() {
      if (!isAllowedUser()) {
        return false;
      }
      let profile = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return profile != null
        && profile.role == 'admin';
    }

    match /settings/config {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /recipes/{recipeId} {
      allow read: if isSignedIn();
      allow create: if isAllowedUser()
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAllowedUser();
      allow delete: if isAdmin();
    }

    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if request.auth.uid == uid
        && request.resource.data.role == 'family';
      allow update, delete: if isAdmin();
    }
  }
}
